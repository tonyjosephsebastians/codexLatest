# OpenAI (personal mode)
OPENAI_API_KEY=...
OPENAI_MODEL=gpt-4o

# Gemini (optional local mode)
GEMINI_API_KEY=...
LLM_MODEL=gemini/gemini-2.0-flash

# Azure OpenAI with Managed Identity (no API keys)
AZURE_OPENAI_ENDPOINT=...
AZURE_OPENAI_DEPLOYMENT=...
AZURE_OPENAI_DEPLOYMENTS=dep-gpt-4o,dep-gpt-5-1
AZURE_OPENAI_API_VERSION=...
AZURE_MANAGED_IDENTITY_CLIENT_ID=...

# Local dev ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# LLM throttling / circuit breaker
LLM_MAX_CONCURRENCY_GEMINI=1
LLM_MIN_INTERVAL_MS_GEMINI=1200
LLM_MAX_CONCURRENCY_AZURE=2
LLM_MIN_INTERVAL_MS_AZURE=250
LLM_CIRCUIT_429_THRESHOLD=3
LLM_CIRCUIT_WINDOW_SECONDS=60
LLM_CIRCUIT_OPEN_SECONDS=30

# LLM budgets / prompt caps
LLM_MAX_TURNS=12
LLM_MAX_TOOL_STEPS=30
LLM_MAX_PROMPT_CHARS=60000
LLM_MAX_SNIPPET_CHARS=2000
LLM_DIGEST_CACHE_TTL_SECONDS=1200
LLM_ANALYSIS_CACHE_TTL_SECONDS=600

# Repo explorer limits
REPO_TREE_MAX_NODES=2000
REPO_TREE_MAX_DEPTH=6
REPO_FILE_MAX_BYTES=200000
